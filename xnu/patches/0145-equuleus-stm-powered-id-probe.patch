 /*
+ * Equuleus powered identification test (sweettouch=3). Live DT + Android:
+ * AVDD = PM8998 L28, 3300 mV (cmd-db ldoa28); VDDIO = active-high GPIO23.
+ * pinctrl-sdm845.c puts GPIO23 in SOUTH, GPIO31..34 in NORTH.
+ * Only power-on: never disable the shared VDDIO supply (also feeds NDT).
+ * No controller firmware, flash, calibration, scan-mode or FIFO writes.
+ */
+static bool
+touch_stm_power_on(void)
+{
+	/* TLMM 0x03400000 + SOUTH 0x00900000 + GPIO23 * 0x1000. */
+	vm_offset_t vddio = ml_io_map(0x03d17000u, 0x1000u);
+	if (!vddio) {
+		printf("EQUULEUS STM: VDDIO GPIO23 mapping failed\n");
+		return false;
+	}
+	uint32_t cfg = touch_rd(vddio, 0), io = touch_rd(vddio, 4);
+	uint32_t rst = touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->rst));
+	printf("EQUULEUS STM: power-before GPIO23(SOUTH)=%#x/%#x RESET32(NORTH)=%#x/%#x\n",
+	    cfg, io, rst, touch_rd(st.gpio, TOUCH_GPIO_IO(tb->rst)));
+	if (cfg == 0xffffffffu || io == 0xffffffffu || rst == 0xffffffffu) {
+		printf("EQUULEUS STM: invalid GPIO readback; power sequence skipped\n");
+		return false;
+	}
+	/* Match Android's active reset/IRQ pulls and 16 mA drive. */
+	touch_gpio(tb->irq, 0, 3, 7, false, false);
+	touch_gpio(tb->rst, 0, 3, 7, true, false);
+	int err = sweet_rpmh_vreg_enable("ldoa28", 3300);
+	printf("EQUULEUS STM: AVDD ldoa28 3300mV vote err=%d\n", err);
+	if (err) {
+		return false; /* RPMh quarantines uncertain transactions: no retry. */
+	}
+	/* GPIO23 is SOUTH: do not call touch_gpio(), which addresses NORTH. */
+	touch_wr(vddio, 4, (io & 2u) | 2u); /* latch high before enabling output */
+	touch_wr(vddio, 0, (cfg & ~0x3ffu) | 0x203u); /* GPIO, pull-up, 2 mA, output */
+	if (!(touch_rd(vddio, 4) & 2u) ||
+	    (touch_rd(vddio, 0) & 0x3ffu) != 0x203u) {
+		printf("EQUULEUS STM: VDDIO GPIO23 latch/config mismatch; stopping\n");
+		return false;
+	}
+	touch_wait(10); /* DT VDDIO startup-delay-us=4000; reset low >=10 ms */
+	touch_gpio(tb->sda, 0, 3, 0, false, false);
+	touch_gpio(tb->scl, 0, 3, 0, false, false);
+	touch_gpio(tb->rst, 0, 3, 7, true, true);
+	touch_wait(100);
+	printf("EQUULEUS STM: power-after GPIO23=%#x/%#x RESET32=%#x/%#x IRQ31=%#x/%#x SDA=%u SCL=%u\n",
+	    touch_rd(vddio, 0), touch_rd(vddio, 4),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->rst)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->rst)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->irq)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)),
+	    (unsigned)bb_get(tb->sda), (unsigned)bb_get(tb->scl));
+	return true;
+}
