diff --git a/bsd/dev/equuleus_wlfw_probe.h b/bsd/dev/equuleus_wlfw_probe.h
new file mode 100644
index 0000000..9747ab8
--- /dev/null
+++ b/bsd/dev/equuleus_wlfw_probe.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: APSL-2.0
+ * Capability-only diagnostic; no MSA sharing or WLAN mode writes.
+ * Wire IDs verified against pinned dipper-xnu 4e82c709 mi8_wlfw.c. */
+#ifndef EQUULEUS_WLFW_PROBE_H
+#define EQUULEUS_WLFW_PROBE_H
+#include "equuleus_glink.h"
+#include <string.h>
+#define EQ_WLFW_SERVICE 69u /* 0x45, NOT decimal45 */
+struct eq_wlfw_probe {
+ const struct redwood_qrtr_ops *ops; struct redwood_qrtr_port *p;
+ void (*log)(void *,const char *,...); void *ctx;
+ uint32_t node,port; uint16_t txn,result,error;
+ uint64_t sent_at; unsigned attempts,rejected,send_errors,tlvs;
+ bool present,pending,answered,success;
+};
+static unsigned eq_wlfw_u16(const uint8_t *p){return p[0]|(unsigned)p[1]<<8;}
+static void eq_wlfw_server(void *ctx,bool up,uint32_t service,uint32_t version,uint32_t instance,uint32_t node,uint32_t port)
+{
+ struct eq_wlfw_probe *w=ctx;
+ if(service!=EQ_WLFW_SERVICE || version!=1 || instance || node || !port || port>=0xfffffffeu)return;
+ if(!up){if(w->present && w->node==node && w->port==port){w->present=false;w->pending=false;w->answered=false;w->success=false;}return;}
+ if(w->present && (w->node!=node || w->port!=port))return;
+ w->present=true;w->node=node;w->port=port;
+ if(w->log)w->log(w->ctx,"eqwl: WLFW service=69/0x45 v1 instance0 peer=%u:%u\n",node,port);
+}
+static void eq_wlfw_receive(void *ctx,uint32_t node,uint32_t port,const void *data,size_t n)
+{
+ struct eq_wlfw_probe *w=ctx; const uint8_t *p=data; bool seen[256]={0};
+ unsigned at=7,result=0,error=0,count=0;
+ if(!w->present || !w->pending || node!=w->node || port!=w->port || !p || n<7 || n>512 || p[0]!=2 ||
+    eq_wlfw_u16(p+1)!=w->txn || eq_wlfw_u16(p+3)!=0x24 || eq_wlfw_u16(p+5)!=n-7)goto bad;
+ while(at<n){
+  if(n-at<3)goto bad;
+  unsigned tag=p[at],len=eq_wlfw_u16(p+at+1);at+=3;
+  if(seen[tag] || len>n-at)goto bad;
+  seen[tag]=true;count++;
+  if(tag==2){if(len!=4)goto bad;result=eq_wlfw_u16(p+at);error=eq_wlfw_u16(p+at+2);if(result>1 || (!result && error))goto bad;}
+  at+=len;
+ }
+ if(!seen[2])goto bad;
+ w->pending=false;w->answered=true;w->result=result;w->error=error;w->success=!result;w->tlvs=count;
+ if(w->log)w->log(w->ctx,"eqwl: CAP response result=%u qmi_error=%u tlvs=%u success=%u\n",result,error,count,w->success?1u:0u);
+ return;
+bad:w->rejected++;
+}
+static bool eq_wlfw_start(struct eq_wlfw_probe *w,const struct redwood_qrtr_ops *ops,void (*log)(void *,const char *,...),void *ctx)
+{
+ memset(w,0,sizeof(*w));w->ops=ops;w->log=log;w->ctx=ctx;
+ if(!ops || !ops->open || !ops->lookup || !ops->send || !ops->close)return false;
+ w->p=ops->open(eq_wlfw_receive,eq_wlfw_server,w);if(!w->p)return false;
+ int r=ops->lookup(w->p,EQ_WLFW_SERVICE,1,0);
+ if(r){ops->close(w->p);w->p=NULL;return false;}return true;
+}
+static void eq_wlfw_poll(struct eq_wlfw_probe *w,uint64_t now,bool wlan_up)
+{
+ if(!w->p || !w->present || !wlan_up || w->answered)return;
+ if(w->attempts && now-w->sent_at<2000000ull)return;
+ if(w->attempts>=3){w->pending=false;return;}
+ uint8_t request[7]={0};w->txn=(uint16_t)(0x163+w->attempts);w->attempts++;
+ request[1]=(uint8_t)w->txn;request[2]=(uint8_t)(w->txn>>8);request[3]=0x24;
+ w->pending=true;w->sent_at=now;
+ int r=w->ops->send(w->p,w->node,w->port,request,sizeof(request));
+ if(r){w->send_errors++;w->pending=false;}
+ if(w->log)w->log(w->ctx,"eqwl: CAP request txn=%u attempt=%u send=%d\n",w->txn,w->attempts,r);
+}
+static void eq_wlfw_stop(struct eq_wlfw_probe *w)
+{
+ if(w->p){w->ops->close(w->p);w->p=NULL;}
+ if(w->log)w->log(w->ctx,"eqwl: summary present=%u answered=%u success=%u attempts=%u result=%u qmi_error=%u rejected=%u send_errors=%u\n",
+  w->present?1u:0u,w->answered?1u:0u,w->success?1u:0u,w->attempts,w->result,w->error,w->rejected,w->send_errors);
+ w->pending=false;
+}
+#endif
