+/* Old completed versions are retained while a reader is still active.
+ * Incomplete uploads are unpublished; losing their session abandons them.
+ * Run only outside dispatch: send callbacks enqueue but never mutate sessions. */
+static void
+ram_collect(struct mi8_hostsvc *h)
+{
+	for (unsigned i=0;i<RAM_FILES;i++) {
+		struct ram_file *f=&h->files[i];
+		bool pinned=false;
+		if (!f->bytes || f->current) continue;
+		for (unsigned j=0;j<SESSIONS;j++) {
+			struct tftp *s=&h->sessions[j];
+			if (s->live && !s->done && s->ram_slot==i+1) { pinned=true; break; }
+		}
+		if (pinned) continue;
+		/* Completed/cancelled sessions must not point at released storage. */
+		for (unsigned j=0;j<SESSIONS;j++) if (h->sessions[j].ram_slot==i+1) {
+			h->sessions[j].live=false; h->sessions[j].ram_slot=0;
+		}
+		volatile uint8_t *v=f->bytes;
+		for (unsigned j=0;j<RAM_FILE_BYTES;j++) v[j]=0;
+		MI8_FREE(f->bytes,RAM_FILE_BYTES); memset(f,0,sizeof(*f));
+	}
+}
