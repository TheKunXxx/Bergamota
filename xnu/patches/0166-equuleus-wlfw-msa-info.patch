 static unsigned eq_wlfw_u16(const uint8_t *p){return p[0]|(unsigned)p[1]<<8;}
 static uint64_t eq_wlfw_u64(const uint8_t *p){uint64_t v=0;for(unsigned i=0;i<8;i++)v|=(uint64_t)p[i]<<(8*i);return v;}
+/* TLV 0x03: u8 count followed by up to two packed 13-byte regions. */
+static bool eq_wlfw_msa_regions(const uint8_t *p,unsigned n)
+{
+ if(!p || !n || p[0]<1 || p[0]>2 || n!=1+13u*p[0])return false;
+ uint64_t base[2],end[2];
+ for(unsigned i=0;i<p[0];i++){
+  const uint8_t *r=p+1+13*i;
+  base[i]=eq_wlfw_u64(r);
+  uint64_t size=(uint64_t)eq_wlfw_u16(r+8)|((uint64_t)eq_wlfw_u16(r+10)<<16);
+  if(r[12]>1 || !size || base[i]<EQ_WLFW_MSA_BASE ||
+     base[i]>=EQ_WLFW_MSA_BASE+EQ_WLFW_MSA_BYTES ||
+     size>EQ_WLFW_MSA_BASE+EQ_WLFW_MSA_BYTES-base[i])return false;
+  end[i]=base[i]+size;
+ }
+ return p[0]==1 || end[0]<=base[1] || end[1]<=base[0];
+}
