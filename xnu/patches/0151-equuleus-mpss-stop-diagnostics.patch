-/* Linux q6v5proc_halt_axi_port (it waits 100 ms for the ack; here 1 s, EXP-0198); true if the port is idle afterwards. */
+/* 0151: read-only snapshots of already used register windows. No ownership change. */
+void
+equuleus_mss_stop_snapshot(const char *phase)
+{
+	static const uint32_t offsets[] = { 0x3000, 0x5000, 0x4000 };
+	static const char *const names[] = { "q6", "modem", "nc" };
+	vm_offset_t tcsr = ml_io_map(TCSR_HALT_PHYS, 0x10000);
+	vm_offset_t rmb = ml_io_map(RMB_PHYS, PAGE_SIZE);
+	vm_offset_t pdc = ml_io_map(PDC_PHYS, PAGE_SIZE);
+	vm_offset_t restart = ml_io_map(AOSS_CC_PHYS, PAGE_SIZE);
+
+	say("eqmss: stop snapshot %s\n", phase);
+	gcc_show();
+	if (tcsr) {
+		for (unsigned i = 0; i < 3; i++) {
+			vm_offset_t port = tcsr + offsets[i];
+			say("eqmss: stop %s %s req %#x ack %#x idle %#x\n", phase,
+			    names[i], rd(port), rd(port + 4), rd(port + 8));
+		}
+	}
+	if (rmb && pdc && restart && strcmp(phase, "after-reset") != 0) {
+		say("eqmss: stop %s MBA %d MSS %#x ALT_RESET %#x PDC %#x RESTART %#x\n",
+		    phase, (int32_t)rd(rmb + RMB_MBA_STATUS), rd(rmb + RMB_MSS_STATUS),
+		    rd(rmb + RMB_ALT_RESET), rd(pdc + PDC_SYNC_RESET), rd(restart));
+	}
+	if (restart) { ml_io_unmap(restart, PAGE_SIZE); }
+	if (pdc) { ml_io_unmap(pdc, PAGE_SIZE); }
+	if (rmb) { ml_io_unmap(rmb, PAGE_SIZE); }
+	if (tcsr) { ml_io_unmap(tcsr, 0x10000); }
+}
+
