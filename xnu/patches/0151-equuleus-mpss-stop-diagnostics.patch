 	for (; waited < 1000 && !(ack = rd(port + 4)); waited++) {
 		delay_for_interval(1, NSEC_PER_MSEC);
 	}
-	say("eqmss: mss: halt port %s: ack %#x after %u ms, idle %#x\n", name, ack, waited, rd(port + 8));
+	idle = rd(port + 8);
+	say("eqmss: mss: halt port %s: request readback %#x ack %#x after %u ms, held idle %#x\n",
+	    name, request, ack, waited, idle);
 	wr(port, 0);
-	return rd(port + 8) != 0;
+	settle();
