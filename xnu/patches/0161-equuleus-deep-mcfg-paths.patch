+static bool
+fs_lfn_match(const uint8_t *e, const char *name)
+{
+ static const uint8_t offsets[]={1,3,5,7,9,14,16,18,20,22,24,28,30};
+ size_t n=name?strlen(name):0;
+ if (!n || n>12 || e[0]!=0x41 || e[11]!=0x0f || e[12] || e[26] || e[27]) return false;
+ for (unsigned i=0;i<13;i++) {
+  unsigned value=e[offsets[i]] | (unsigned)e[offsets[i]+1]<<8;
+  if (i<n) {
+   unsigned want=(unsigned char)name[i];
+   if (value>127) return false;
+   if (value>='a' && value<='z') value-=32;
+   if (want>='a' && want<='z') want-=32;
+   if (value!=want) return false;
+  } else if (value!=(i==n?0u:0xffffu)) return false;
+ }
+ return true;
+}
+static uint8_t
+fs_name_checksum(const uint8_t *name)
+{
+ uint8_t sum=0;
+ for (unsigned i=0;i<11;i++) sum=(uint8_t)(((sum&1)?128:0)+(sum>>1)+name[i]);
+ return sum;
+}
