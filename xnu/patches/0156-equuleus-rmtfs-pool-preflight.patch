 /* Called on the existing delayed WLAN thread, once, only for equuleus. */
+/* 0156 preflight: CPU-owned pool; no SCM calls, no remote processor start. */
+extern int sweet_ufs_part_size(const char *, uint8_t *, uint64_t *);
+static bool eq_rmt_guards(volatile uint64_t *pool)
+{
+ for (uint64_t i=0;i<EQ_RMT_PAGE/8;i++) {
+  if (pool[EQ_RMT_PAGE/8+i]!=EQ_RMT_GUARD ||
+      pool[(2*EQ_RMT_PAGE+EQ_RMT_BYTES)/8+i]!=EQ_RMT_GUARD) return false;
+ }
+ return true;
+}
+void equuleus_rmtfs_preflight(void)
+{
+ static vm_offset_t mapping;
+ struct eq_rmt_contract contract;
+ volatile uint64_t *pool, *data;
+ uint8_t *block=NULL;
+ bool ok=false;
+ const char *const names[]={"modemst1","modemst2","fsg","fsc"};
+ const uint64_t expected[]={0x800000,0x800000,0x800000,0x40000};
+ say("eqrmt: port0156 mode11 preflight; no SCM, no RMTFS publication, no NV writes\n");
+ unsigned stamp=0;
+ if (!PE_parse_boot_argn("eqrmtfs_pool",&stamp,sizeof(stamp)) || stamp!=156) {
+  say("eqrmt: this boot has no shim reservation stamp; refusing map\n");return;
+ }
+ if (PAGE_SIZE!=EQ_RMT_PAGE) {say("eqrmt: unsupported kernel page size\n");return;}
+ if (!mapping) mapping=io_map(EQ_RMT_POOL,EQ_RMT_SPAN,VM_WIMG_WCOMB,VM_PROT_READ|VM_PROT_WRITE,true);
+ if (!mapping) {say("eqrmt: pool map failed\n");return;}
+ pool=(volatile uint64_t *)mapping;
+ uint64_t *words=(uint64_t *)&contract;
+ for(unsigned i=0;i<sizeof(contract)/8;i++)words[i]=pool[i];
+ if (!eq_rmt_valid(&contract)) {say("eqrmt: missing/invalid shim reservation; refusing writes\n");return;}
+ if (!eq_rmt_guards(pool)) {say("eqrmt: pool guard mismatch before test\n");return;}
+ data=(volatile uint64_t *)(mapping+2*EQ_RMT_PAGE);
+ for(uint64_t i=0;i<EQ_RMT_BYTES/8;i++)if(data[i]){say("eqrmt: pool not zero at word %llu; refusing writes\n",i);return;}
+ data[0]=EQ_RMT_GUARD;data[EQ_RMT_BYTES/8-1]=~EQ_RMT_GUARD;settle();
+ bool echoed=data[0]==EQ_RMT_GUARD && data[EQ_RMT_BYTES/8-1]==~EQ_RMT_GUARD;
+ data[0]=data[EQ_RMT_BYTES/8-1]=0;settle();
+ if (!echoed || !eq_rmt_guards(pool)) {say("eqrmt: pool readback or guard test failed\n");return;}
+ say("eqrmt: reserved CPU pool data=%#llx bytes=%#llx guards/readback OK\n",(uint64_t)EQ_RMT_DATA,(uint64_t)EQ_RMT_BYTES);
+ block=kalloc_data(4096,Z_WAITOK|Z_ZERO);
+ if (!block){say("eqrmt: read buffer allocation failed\n");return;}
+ for(unsigned i=0;i<4;i++) {
+  uint8_t lun=0;uint64_t bytes=0;
+  int result=sweet_ufs_part_size(names[i],&lun,&bytes);
+  say("eqrmt: partition %s size_rc=%d lun=%u bytes=%llu expected=%llu\n",names[i],result,lun,bytes,expected[i]);
+  if(result || bytes!=expected[i])goto out;
+  result=sweet_ufs_read_part(names[i],0,block,4096);
+  say("eqrmt: partition %s first-block read rc=%d (contents omitted)\n",names[i],result);
+  if(result)goto out;
+ }
+ ok=true;
+out:
+ bzero(block,4096);kfree_data(block,4096);
+ say("eqrmt: preflight %s; pool remains CPU-owned until full reboot\n",ok?"PASS":"FAIL");
+}
