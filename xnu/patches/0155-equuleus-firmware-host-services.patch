+static bool eq_firmware_path(const char *p)
+{
+ if (!p || strncmp(p, "image/", 6)) return false;
+ p += 6;
+ size_t n = strlen(p);
+ if (!n || n > 12 || !strcmp(p, ".") || !strcmp(p, "..")) return false;
+ for (size_t i=0; i<n; i++) {
+  unsigned char c = (unsigned char)p[i];
+  if (!((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='.' || c=='_' || c=='-')) return false;
+ }
+ return true;
