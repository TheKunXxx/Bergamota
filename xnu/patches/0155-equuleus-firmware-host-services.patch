+ * Firmware-only host-service extraction from dipper-xnu 4e82c709ea42ebb509fa101b52972fdc890b873e.
+ * Equuleus changes: firmware-only host services, bounded polling and read-only file adapter.
+ */
+#ifndef MI8_HOSTSVC_H
+#define MI8_HOSTSVC_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct redwood_qrtr_ops;
+struct redwood_qrtr_port;
+struct mi8_pd_domain {
+	const char *name;
+	uint32_t instance;
+	const char *const *services;
+	unsigned n_services;
+};
+
+struct mi8_hostsvc_cfg {
+	const struct redwood_qrtr_ops *qrtr;
+	int (*publish)(void *, struct redwood_qrtr_port *, uint32_t, uint32_t, uint32_t);
+	int (*file_size)(void *, const char *, uint64_t *);
+	int (*file_read)(void *, const char *, uint64_t, void *, uint64_t);
+	const struct mi8_pd_domain *domains;
+	unsigned n_domains;
+	void (*log)(void *, const char *, ...);
+	void *ctx;
+};
+
+/* Caller may copy/replace this table; create uses it only when domains == NULL. */
+extern const struct mi8_pd_domain mi8_hostsvc_sdm845_domains[];
+extern const unsigned mi8_hostsvc_sdm845_n_domains;
+
+struct mi8_hostsvc;
+struct mi8_hostsvc *mi8_hostsvc_create(const struct mi8_hostsvc_cfg *);
+int mi8_hostsvc_start(struct mi8_hostsvc *);
+void mi8_hostsvc_poll(struct mi8_hostsvc *);
+void mi8_hostsvc_stop(struct mi8_hostsvc *);
+void mi8_hostsvc_destroy(struct mi8_hostsvc *);
+
+/*
+ * Lifecycle calls must not run from a receive callback. QRTR must serialize
+ * callbacks (including reentrant callbacks from send); the service queues them.
+ * Buffers/domain strings and callback ctx outlive the instance. Reads return
+ * zero only after filling the complete requested byte range. No write API.
+ */
+#endif
