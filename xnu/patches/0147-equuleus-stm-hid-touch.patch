+static void touch_report(uint32_t mask, const int *x, const int *y);
+
+/* ST FIFO is a stream of per-slot deltas, NOT a complete touch frame.
+ * Preserve every other slot when one finger moves or leaves. The HID service
+ * already maps physical pixels to the sweetfb_scale canvas; do not scale here.
+ */
+static void
+touch_stm_hid_event(const uint8_t *data)
+{
+	if (data[0] != 0x13 && data[0] != 0x23 && data[0] != 0x33) {
+		return;
+	}
+	unsigned id = data[1] >> 4, type = data[1] & 15u;
+	if (id >= TOUCH_MAX) {
+		return;
+	}
+	uint32_t bit = 1u << id, mask = st.active;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	memcpy(x, st.x, sizeof(x));
+	memcpy(y, st.y, sizeof(y));
+	unsigned px = data[2] | ((data[3] & 15u) << 8);
+	unsigned py = (data[4] << 4) | (data[3] >> 4);
+	/* Leave records need only a valid slot; coordinates/type may be absent.
+	 * Finger/glove only: palm, hover, stylus and malformed points release
+	 * this slot rather than synthesizing a tap or leaving it stuck down.
+	 */
+	if (data[0] == 0x33 || (type != 1 && type != 2) ||
+	    px >= tb->w || py >= tb->h) {
+		mask &= ~bit;
+	} else {
+		x[id] = (int)px;
+		y[id] = (int)py;
+		mask |= bit;
+	}
+	touch_report(mask, x, y);
+}
