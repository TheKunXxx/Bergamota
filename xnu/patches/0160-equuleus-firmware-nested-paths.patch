+/* Strict 8.3 components: do not silently truncate names into another file. */
+static bool
+fs_component83(const char *p, size_t n)
+{
+	size_t base=0, ext=0; bool dot=false;
+	if (!n) return false;
+	for (size_t i=0;i<n;i++) {
+		unsigned char c=(unsigned char)p[i];
+		if (c=='.') { if (dot || !base) return false; dot=true; continue; }
+		if (!((c>='a' && c<='z') || (c>='A' && c<='Z') ||
+		    (c>='0' && c<='9') || c=='_' || c=='-')) return false;
+		if (dot) { if (++ext>3) return false; } else if (++base>8) return false;
+	}
+	return base && (!dot || ext);
+}
