+/*
+ * Read-only equuleus bring-up. Reference: LineageOS SDM845 kernel
+ * aa8adfe9bf212c6e93238a86980b4024da4f819a, fts_521/fts_lib/
+ * ftsHardware.h and ftsFlash.c: I2C 0x49, HW_REG_R 0xfa, four-byte
+ * big-endian address, no dummy byte on I2C, FTM5 chip ID 0x36/0x39.
+ * No reset, scan-mode, interrupt-enable, calibration or flash commands.
+ * Bit-bang only: no dependency on the ABL's GENI firmware or GPI DMA.
+ */
+static void
+touch_stm_probe_only(void)
+{
+	const uint8_t cmd[5] = {0xfa, 0x20, 0x00, 0x00, 0x00};
+	uint8_t data[8] = {0};
+	uint32_t sda_cfg = touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->sda));
+	uint32_t scl_cfg = touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->scl));
+	uint32_t sda_io = touch_rd(st.gpio, TOUCH_GPIO_IO(tb->sda));
+	uint32_t scl_io = touch_rd(st.gpio, TOUCH_GPIO_IO(tb->scl));
+	printf("EQUULEUS STM: probe-only rst=%#x/%#x irq=%#x/%#x SDA=%#x/%#x SCL=%#x/%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->rst)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->rst)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->irq)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)),
+	    sda_cfg, sda_io, scl_cfg, scl_io);
+	/* Release both open-drain lines. Leave reset, IRQ and power untouched. */
+	touch_gpio(tb->sda, 0, 0, 0, false, false);
+	touch_gpio(tb->scl, 0, 0, 0, false, false);
+	touch_wait(2);
+	bool idle = bb_get(tb->sda) && bb_get(tb->scl);
+	if (!idle) {
+		printf("EQUULEUS STM: bus not idle SDA=%u SCL=%u; read skipped\n",
+		    (unsigned)bb_get(tb->sda), (unsigned)bb_get(tb->scl));
+	} else {
+		st.probing = true;
+		int err = bb_xfer(0x49, cmd, sizeof(cmd), data, sizeof(data));
+		st.probing = false;
+		printf("EQUULEUS STM: FA 20000000 err=%d raw=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    err, data[0], data[1], data[2], data[3], data[4], data[5], data[6], data[7]);
+		if (!err && data[0] == 0x36 && data[1] == 0x39) {
+			printf("EQUULEUS STM: FTM5 ID matched; FW raw=%02x:%02x; no HID events in probe mode\n",
+			    data[4], data[5]);
+		} else {
+			printf("EQUULEUS STM: no confirmed FTM5 identity; stopping without reset or writes\n");
+		}
+	}
+	/* Restore the bootloader's GPIO configuration and output latches. */
+	touch_wr(st.gpio, TOUCH_GPIO_IO(tb->sda), sda_io & 2u);
+	touch_wr(st.gpio, TOUCH_GPIO_IO(tb->scl), scl_io & 2u);
+	touch_wr(st.gpio, TOUCH_GPIO_CFG(tb->sda), sda_cfg);
+	touch_wr(st.gpio, TOUCH_GPIO_CFG(tb->scl), scl_cfg);
+	printf("EQUULEUS STM: probe complete; pin configuration restored\n");
+}
