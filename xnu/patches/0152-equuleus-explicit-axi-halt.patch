+/* 0152: explicit mode 7 follows downstream PIL's request on every AXI port.
+ * IDLE alone need not imply that the port has accepted an isolation request.
+ * Keep mode 6 unchanged for comparison; no failed request permits reclaim.
+ */
+static bool mss_halt_all;
+
+bool
+equuleus_mss_halt_all(void)
+{
+	return mss_halt_all;
+}
+
 /* Linux samples IDLE before clearing HALTREQ. A late post-clear change is not proof of halt. */
 static bool
 halt_port(const char *name, vm_offset_t port)
 {
 	uint32_t ack = 0, waited = 0, request, idle;
 
-	if (rd(port + 8)) {
+	if (!equuleus_mss_halt_all() && rd(port + 8)) {
 		say("eqmss: mss: halt port %s is idle already\n", name);
 		return true;
 	}
@@ -1059,7 +1071,7 @@
 	say("eqmss: mss: halt port %s: released req %#x ack %#x idle %#x\n",
 	    name, rd(port), rd(port + 4), rd(port + 8));
 	/* Like Linux, IDLE is authoritative; reject an unlatched request on this explicit request path. */
-	return request == 1 && idle != 0;
+	return request == 1 && idle != 0 && (!equuleus_mss_halt_all() || ack != 0);
 }
 
