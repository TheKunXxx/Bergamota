+/* Read the installed SMMUv2 stream routes without changing the shared SMMU. */
+static bool eq_wlfw_smmu_bypass(struct eq_wlfw_probe *w)
+{
+ w->wlan_smmu=ml_io_map(0x15000000ul,0x1000);
+ if(!w->wlan_smmu)return false;
+ uint32_t cr0=rd(w->wlan_smmu),id0=rd(w->wlan_smmu+0x20);
+ unsigned count=id0&0xffu;
+ if(w->log)w->log(w->ctx,"eqwl: SMMU CR0=%#x ID0=%#x groups=%u\n",cr0,id0,count);
+ if(id0==UINT32_MAX || !(id0&(1u<<27)) || !count || (cr0&1))return false;
+ const bool ext=(cr0&(1u<<3)) && (id0&(1u<<8));
+ unsigned matches[2]={0},bypass[2]={0};
+ for(unsigned i=0;i<count;i++){
+  uint32_t smr=rd(w->wlan_smmu+0x800+4*i),s2cr=rd(w->wlan_smmu+0xc00+4*i);
+  if(!(ext?(s2cr&(1u<<10)):(smr&(1u<<31))))continue;
+  unsigned width=ext?0xffffu:0x7fffu;
+  unsigned mask=(smr>>16)&width, id=smr&width;
+  for(unsigned j=0;j<2;j++){
+   if(((id^(0x40u+j))&~mask)!=0)continue;
+   matches[j]++;
+   if(((s2cr>>16)&3)==1)bypass[j]++;
+   if(w->log)w->log(w->ctx,"eqwl: SMMU sid=%#x slot=%u SMR=%#x S2CR=%#x\n",0x40u+j,i,smr,s2cr);
+  }
+ }
+ return matches[0]==1 && matches[1]==1 && bypass[0]==1 && bypass[1]==1;
+}
+static bool eq_wlfw_power(struct eq_wlfw_probe *w)
+{
+ const struct {const char *name;uint32_t mv;} rails[]={
+  {"ldoa5",800},{"ldoa7",1800},{"ldoa17",1300},{"ldoa25",3300}
+ };
+ uint32_t addr[4]={0};
+ for(unsigned i=0;i<4;i++){
+  if(rail_position(rails[i].name,0,&addr[i],false)!=0 || !addr[i] ||
+     addr[i]>UINT32_MAX-8 || (addr[i]&3)){
+   if(w->log)w->log(w->ctx,"eqwl: power missing rail %s\n",rails[i].name);
+   return false;
+  }
+ }
+ for(unsigned i=0;i<4;i++){
+  const char *name=rails[i].name;
+  if(!rpmh_write(name,addr[i],rails[i].mv) ||
+     !rpmh_write(name,addr[i]+8,7) ||
+     !rpmh_write(name,addr[i]+4,1)){
+   if(w->log)w->log(w->ctx,"eqwl: power vote failed rail=%s\n",name);
+   return false;
+  }
+  delay_for_interval(1,NSEC_PER_MSEC);
+ }
+ return true;
+}
