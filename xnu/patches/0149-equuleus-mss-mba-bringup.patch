+/* Share the existing RPMh transaction lock with the equuleus MSS probe. */
+int
+sweet_rpmh_bus_acquire(void)
+{
+    if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) { return EBUSY; }
+    if (rh_poisoned) {
+        __atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+        return EIO;
+    }
+    return 0;
+}
+
+void
+sweet_rpmh_bus_poison(void)
+{
+    rh_poisoned = true;
+}
+
+void
+sweet_rpmh_bus_release(void)
+{
+    __atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+}
