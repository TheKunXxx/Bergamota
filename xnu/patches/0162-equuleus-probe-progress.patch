+/* Snapshot before freeing queues, sessions or RAM; no sends or mutations. */
+void
+mi8_hostsvc_snapshot(struct mi8_hostsvc *h)
+{
+ if (!h || !h->cfg.log) return;
+ unsigned rrq=0,wrq=0;
+ for (unsigned i=0;i<SESSIONS;i++) {
+  const struct tftp *s=&h->sessions[i];
+  if (!s->live || s->done) continue;
+  if (s->write) wrq++; else rrq++;
+  uint64_t bytes=s->write?h->files[s->ram_slot-1].size:s->sent*s->blocksize;
+  if (!s->write && bytes>s->size) bytes=s->size;
+  h->cfg.log(h->cfg.ctx,"mi8hs: active %s peer=%u:%u file=%s bytes=%llu size=%llu ack=%llu sent=%llu oack=%u\n",
+   s->write?"WRQ":"RRQ",s->node,s->port,s->path,(unsigned long long)bytes,(unsigned long long)s->size,
+   (unsigned long long)s->acked,(unsigned long long)s->sent,s->oack?1u:0u);
+ }
+ h->cfg.log(h->cfg.ctx,"mi8hs: progress rrq_done=%u active_rrq=%u active_wrq=%u queued=%u peak=%u tx_bytes=%llu send_errors=%u no_reply=%u queue_drops=%u budget_drops=%u alloc_drops=%u reply_cap_drops=%u\n",
+  h->rrq_complete,rrq,wrq,h->queued,h->queue_peak,(unsigned long long)h->data_sent,h->send_errors,h->no_reply,h->queue_drops,h->budget_drops,h->alloc_drops,h->reply_cap_drops);
+}
+
 void
 mi8_hostsvc_stop(struct mi8_hostsvc *h)
 {
@@ -706,6 +738,7 @@ mi8_hostsvc_stop(struct mi8_hostsvc *h)
 	for (i = 0; i < 3; i++) if (h->endpoints[i].port) {
 		h->cfg.qrtr->close(h->endpoints[i].port); h->endpoints[i].port = NULL;
 	}
+	mi8_hostsvc_snapshot(h);
 	h->started = false;
 	while ((p = h->first) != NULL) { h->first = p->next; MI8_FREE(p, sizeof(*p) + p->length); }
 	h->last = NULL; h->queued = 0;
