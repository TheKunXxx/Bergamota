+
+#define INSTANCES 8
+#define PORTS 16
+#define LOOKUPS 16
+#define SERVERS 64
+#define INTENTS 64
+#define MAX_PACKET 65536u
+#define WAIT_US 5000000u
+#define CTRL 0xfffffffeu
+#define BCAST 0xffffffffu
+#define RESERVE 16u
+#define LOG(g, ...) do { if ((g)->cfg.log) (g)->cfg.log((g)->cfg.ctx, __VA_ARGS__); } while (0)
+
+enum {
+	VERSION = 0, VERSION_ACK = 1, OPEN = 2, CLOSE = 3, OPEN_ACK = 4,
+	INTENT = 5, DONE = 6, INTENT_REQ = 7, INTENT_ACK = 8, DATA = 9,
+	CLOSE_ACK = 11, DATA_MORE = 12, READ_NOTIFY = 13, DONE_REUSE = 14, SIGNALS = 15
+};
+enum {
+	Q_DATA = 1, Q_HELLO = 2, Q_BYE = 3, Q_NEW_SERVER = 4, Q_DEL_SERVER = 5,
+	Q_DEL_CLIENT = 6, Q_RESUME = 7, Q_NEW_LOOKUP = 10, Q_DEL_LOOKUP = 11
+};
+
+struct intent {
+	uint32_t id, size, fill, left;
+	bool there, busy, reusable;
+	uint8_t *data;
+};
+struct lookup {
+	bool used;
+	uint32_t service, version, instance;
+};
+struct redwood_qrtr_port {
+	struct mi8_glink *g;
+	bool live;
+	uint32_t id, generation;
+	redwood_qrtr_receive_t receive;
+	redwood_qrtr_server_t server;
+	void *ctx;
+	struct lookup lookups[LOOKUPS];
+	bool published;
+	uint32_t service, version, instance;
+};
+struct command {
+	struct command *next;
+	uint32_t length;
+	uint8_t bytes[48];
+};
+struct outgoing {
+	struct outgoing *next;
+	uint32_t length, offset, iid;
+	uint64_t since;
+	int error;
+	bool requested, answered, granted, synchronous, done;
+	uint8_t bytes[];
+};
+struct mi8_glink {
+	struct mi8_glink_cfg cfg;
+	uintptr_t owner;
+	unsigned depth, slot;
+	uint32_t desc, tx, tx_size, rx, rx_size;
+	bool up, broken, agreed, asked, acked, opened, closing, hello;
+	bool notified;
+	uint32_t notify_tail, features, remote, peer, next_port, next_intent;
+	struct intent local[INTENTS], foreign[INTENTS];
+	struct command *commands, *command_last;
+	unsigned command_count, outgoing_count;
+	struct outgoing *outgoing, *outgoing_last;
+	struct redwood_qrtr_port ports[PORTS];
+	struct mi8_qrtr_server servers[SERVERS];
+	bool present[SERVERS];
+};
+static struct mi8_glink *instances[INSTANCES];
+static void pump(struct mi8_glink *);
+static void progress(struct mi8_glink *);
+static void qrtr_input(struct mi8_glink *, const uint8_t *, uint32_t);
+static void drop_servers(struct mi8_glink *, uint32_t);
+
+static uint32_t
+get32(const void *v)
+{
+	const uint8_t *p = v;
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint32_t
+get16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8;
+}
+
+static void
+put32(uint8_t *p, uint32_t n)
+{
+	p[0] = (uint8_t)n; p[1] = (uint8_t)(n >> 8);
+	p[2] = (uint8_t)(n >> 16); p[3] = (uint8_t)(n >> 24);
+}
+
+static void
+header(uint8_t *p, unsigned cmd, uint32_t cid, uint32_t arg)
+{
+	p[0] = (uint8_t)cmd; p[1] = 0;
+	p[2] = (uint8_t)cid; p[3] = (uint8_t)(cid >> 8);
+	put32(p + 4, arg);
+}
+
+static void
+enter(struct mi8_glink *g)
+{
+	uintptr_t me = MI8_THREAD_ID(), empty;
+	if (__atomic_load_n(&g->owner, __ATOMIC_ACQUIRE) == me) {
+		g->depth++;
+		return;
+	}
+	do {
+		empty = 0;
+		if (__atomic_compare_exchange_n(&g->owner, &empty, me, false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+			g->depth = 1;
+			return;
+		}
+		g->cfg.sleep_us(g->cfg.ctx, 1000);
+	} while (true);
+}
+
+static void
+leave(struct mi8_glink *g)
+{
+	if (--g->depth == 0)
+		__atomic_store_n(&g->owner, 0, __ATOMIC_RELEASE);
+}
+
+static void
+broken(struct mi8_glink *g, const char *why)
+{
+	if (!g->broken)
+		LOG(g, "mi8gl: GLINK error: %s (%s pid %u)\n", why, g->cfg.name, g->cfg.remote_pid);
+	g->broken = true;
+}
+
+static uint32_t
+word(struct mi8_glink *g, uint32_t at)
+{
+	uint8_t p[4];
+	g->cfg.smem_read(g->cfg.ctx, at, p, 4);
+	return get32(p);
+}
+
+static void
+write_word(struct mi8_glink *g, uint32_t at, uint32_t value)
+{
+	__sync_synchronize();
+	g->cfg.smem_write32(g->cfg.ctx, at, value);
+	__sync_synchronize();
+}
+
+static bool
+marks(struct mi8_glink *g, bool tx, uint32_t *head, uint32_t *tail)
+{
+	uint32_t d = g->desc + (tx ? 0 : 8), size = tx ? g->tx_size : g->rx_size;
+	*head = word(g, d + 4);
+	*tail = word(g, d);
+	__sync_synchronize();
+	if (*head >= size || *tail >= size || ((*head | *tail) & 7)) {
+		broken(g, "invalid FIFO marks");
+		return false;
+	}
+	return true;
+}
+
+static uint32_t
+room(struct mi8_glink *g, bool reserve)
+{
+	uint32_t h, t, n, keep = reserve ? RESERVE : 8;
+	if (!marks(g, true, &h, &t))
+		return 0;
+	n = t <= h ? g->tx_size - h + t : t - h;
+	return n > keep ? n - keep : 0;
+}
+
+static void
+peek(struct mi8_glink *g, uint32_t tail, uint32_t offset, void *dst, uint32_t n)
+{
+	uint32_t at = (tail + offset) % g->rx_size, first = g->rx_size - at;
+	if (first > n) first = n;
+	g->cfg.smem_read(g->cfg.ctx, g->rx + at, dst, first);
+	if (first != n)
+		g->cfg.smem_read(g->cfg.ctx, g->rx, (uint8_t *)dst + first, n - first);
+}
+
+static bool
+emit(struct mi8_glink *g, const uint8_t *h, uint32_t hn, const uint8_t *p, uint32_t pn, bool reserve)
+{
+	uint32_t head, tail, n = hn + pn, padded = (n + 7) & ~7u, i;
+	if (!g->up || g->broken || room(g, reserve) < padded || !marks(g, true, &head, &tail))
+		return false;
+	for (i = 0; i < padded; i += 4) {
+		uint8_t b[4];
+		unsigned j;
+		for (j = 0; j < 4; j++) {
+			uint32_t k = i + j;
+			b[j] = k < hn ? h[k] : k < n ? p[k - hn] : 0;
+		}
+		g->cfg.smem_write32(g->cfg.ctx, g->tx + (head + i) % g->tx_size, get32(b));
+	}
+	write_word(g, g->desc + 4, (head + padded) % g->tx_size);
+	g->cfg.ring(g->cfg.ctx);
+	return true;
+}
+
+static void
+notify(struct mi8_glink *g)
+{
+	uint8_t b[8];
+	uint32_t tail = word(g, g->desc);
+	if (g->notified && tail == g->notify_tail) return;
+	header(b, READ_NOTIFY, 0, 0);
+	if (emit(g, b, 8, NULL, 0, false)) {
+		g->notified = true;
+		g->notify_tail = tail;
+	}
+}
+
+static void
+flush(struct mi8_glink *g)
+{
+	struct command *c;
+	while ((c = g->commands) != NULL && !g->broken) {
+		if (!emit(g, c->bytes, c->length, NULL, 0, true)) {
+			notify(g);
+			break;
+		}
+		g->commands = c->next;
+		if (!g->commands) g->command_last = NULL;
+		g->command_count--;
+		MI8_FREE(c, sizeof(*c));
+	}
+}
+
+static bool
+say(struct mi8_glink *g, unsigned cmd, uint32_t cid, uint32_t arg, const void *p, uint32_t n)
+{
+	struct command *c;
+	if (g->broken) return false;
+	if (n > 40 || g->command_count == 256 || !(c = MI8_ALLOC(sizeof(*c)))) {
+		broken(g, "control queue exhausted");
+		return false;
+	}
+	memset(c, 0, sizeof(*c));
+	header(c->bytes, cmd, cid, arg);
+	if (n) memcpy(c->bytes + 8, p, n);
+	c->length = 8 + n;
+	if (g->command_last) g->command_last->next = c;
+	else g->commands = c;
+	g->command_last = c;
+	g->command_count++;
+	flush(g);
+	return !g->broken;
+}
+
+static bool
+offer(struct mi8_glink *g, uint32_t size, bool reusable)
+{
+	unsigned i;
+	uint8_t pair[8];
+	for (i = 0; i < INTENTS; i++) if (!g->local[i].there) break;
+	if (i == INTENTS || !size || size > MAX_PACKET || g->next_intent == UINT32_MAX) return false;
+	g->local[i].data = MI8_ALLOC(size);
+	if (!g->local[i].data) return false;
+	g->local[i].there = true;
+	g->local[i].size = size;
+	g->local[i].id = ++g->next_intent;
+	g->local[i].reusable = reusable;
+	put32(pair, size); put32(pair + 4, g->local[i].id);
+	return say(g, INTENT, 1, 1, pair, 8);
+}
+
+static struct outgoing *
+queue_packet(struct mi8_glink *g, uint32_t type, uint32_t from, uint32_t node, uint32_t port,
+    const void *p, uint32_t n, bool synchronous)
+{
+	uint32_t len = 32 + ((n + 3) & ~3u);
+	struct outgoing *o;
+	if (g->outgoing_count == 64 || !(o = MI8_ALLOC(sizeof(*o) + len))) return NULL;
+	memset(o, 0, sizeof(*o) + len);
+	o->length = len;
+	o->synchronous = synchronous;
+	o->since = g->cfg.now_us(g->cfg.ctx);
+	put32(o->bytes, 1); put32(o->bytes + 4, type);
+	put32(o->bytes + 8, g->cfg.local_node); put32(o->bytes + 12, from);
+	put32(o->bytes + 20, n); put32(o->bytes + 24, node); put32(o->bytes + 28, port);
+	if (n) memcpy(o->bytes + 32, p, n);
+	if (g->outgoing_last) g->outgoing_last->next = o;
+	else g->outgoing = o;
+	g->outgoing_last = o;
+	g->outgoing_count++;
+	return o;
+}
+
+static void
+control(struct mi8_glink *g, uint32_t type, uint32_t from, uint32_t node, uint32_t port,
+    uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{
+	uint8_t p[20];
+	put32(p, type); put32(p + 4, a); put32(p + 8, b); put32(p + 12, c); put32(p + 16, d);
+	if (!queue_packet(g, type, from, node, port, p, 20, false)) broken(g, "QRTR control queue exhausted");
+}
+
+static void
+publish_notice(struct mi8_glink *g, struct redwood_qrtr_port *p, uint32_t type, uint32_t node, uint32_t port)
+{
+	uint8_t body[20];
+	put32(body, type); put32(body + 4, p->service);
+	put32(body + 8, p->version | p->instance << 8);
+	put32(body + 12, g->cfg.local_node); put32(body + 16, p->id);
+	if (!queue_packet(g, port == CTRL ? type : Q_DATA, CTRL, node, port, body, 20, false))
+		broken(g, "local service announcement queue exhausted");
+}
+
+static void
+finish(struct mi8_glink *g, int error)
+{
+	struct outgoing *o = g->outgoing;
+	unsigned i;
+	if (error && !o->offset && o->iid) for (i = 0; i < INTENTS; i++)
+		if (g->foreign[i].there && g->foreign[i].id == o->iid) g->foreign[i].busy = false;
+	if (error && o->length > 1000) LOG(g, "mi8gl: send of %u bytes FAILED (%d), offset %u, intent %u\n", o->length, error, o->offset, o->iid);
+	g->outgoing = o->next;
+	if (!g->outgoing) g->outgoing_last = NULL;
+	g->outgoing_count--;
+	o->done = true; o->error = error;
+	if (!o->synchronous) {
+		if (error) LOG(g, "mi8gl: GLINK error: QRTR control send errno %d\n", error);
+		MI8_FREE(o, sizeof(*o) + o->length);
+	}
+}
+
+static void
+progress(struct mi8_glink *g)
+{
+	struct outgoing *o;
+	unsigned budget = 128;
+	flush(g);
+	while (budget-- && (o = g->outgoing) != NULL) {
+		uint32_t n, available;
+		uint8_t h[16];
+		int best = -1;
+		unsigned i;
+		if (!g->up || g->broken || !g->opened) {
+			finish(g, ENOTCONN);
+			continue;
+		}
+		if (g->cfg.now_us(g->cfg.ctx) - o->since >= WAIT_US) {
+			if (o->offset) broken(g, "partial transmit timed out");
+			finish(g, ETIMEDOUT);
+			continue;
+		}
+		if (g->commands) return;
+		if (!o->iid) {
+			for (i = 0; i < INTENTS; i++) {
+				struct intent *v = &g->foreign[i];
+				if (v->there && !v->busy && v->size >= o->length &&
+				    (best < 0 || v->size < g->foreign[best].size)) best = (int)i;
+			}
+			if (best < 0) {
+				if (o->answered && !o->granted) { finish(g, ENOBUFS); continue; }
+				if (!o->requested) {
+					o->requested = true;
+					if (o->length > 1000) LOG(g, "mi8gl: no remote intent for %u bytes: asks for one\n", o->length);
+					say(g, INTENT_REQ, 1, o->length, NULL, 0);
+				}
+				return;
+			}
+			g->foreign[best].busy = true;
+			o->iid = g->foreign[best].id;
+			if (o->length > 1000) LOG(g, "mi8gl: sends %u bytes in remote intent %u (size %u)\n", o->length, o->iid, g->foreign[best].size);
+		}
+		available = room(g, true);
+		if (available < 24) { notify(g); return; }
+		n = o->length - o->offset;
+		if (n > 8192) n = 8192;
+		if (n > available - 16) n = (available - 16) & ~7u;
+		header(h, o->offset ? DATA_MORE : DATA, 1, o->iid);
+		put32(h + 8, n); put32(h + 12, o->length - o->offset - n);
+		if (!emit(g, h, 16, o->bytes + o->offset, n, true)) return;
+		o->offset += n;
+		if (o->offset == o->length) finish(g, 0);
+	}
+}
+
+static bool
+matches(const struct lookup *l, const struct mi8_qrtr_server *s)
+{
+	return l->used && (!l->service || l->service == s->service) &&
+	    ((!l->version && !l->instance) || (l->version == s->version && l->instance == s->instance));
+}
+
+static void
+announce(struct mi8_glink *g, bool arrived, struct mi8_qrtr_server s)
+{
+	unsigned i, j;
+	for (i = 0; i < PORTS; i++) {
+		struct redwood_qrtr_port *p = &g->ports[i];
+		if (!p->live || !p->server) continue;
+		for (j = 0; j < LOOKUPS; j++) {
+			if (matches(&p->lookups[j], &s)) {
+				p->server(p->ctx, arrived, s.service, s.version, s.instance, s.node, s.port);
+				break;
+			}
+		}
+	}
+}
+
+static void
+drop_servers(struct mi8_glink *g, uint32_t node)
+{
+	unsigned i;
+	for (i = 0; i < SERVERS; i++) if (g->present[i] && (node == BCAST || g->servers[i].node == node)) {
+		struct mi8_qrtr_server s = g->servers[i];
+		g->present[i] = false;
+		announce(g, false, s);
+	}
+}
+
+static void
+qrtr_input(struct mi8_glink *g, const uint8_t *p, uint32_t len)
+{
+	uint32_t type, sn, sp, dn, dp, confirm, size, at, command;
+	unsigned i;
+	if (len < 16 || (len & 3)) goto bad;
+	if (p[0] == 1) {
+		if (len < 32 || get32(p) != 1) goto bad;
+		type = get32(p + 4); sn = get32(p + 8); sp = get32(p + 12);
+		confirm = get32(p + 16); size = get32(p + 20);
+		dn = get32(p + 24); dp = get32(p + 28); at = 32;
+	} else if (p[0] == 3) {
+		type = p[1]; confirm = p[2] & 1; at = 16u + p[3]; size = get32(p + 4);
+		sn = get16(p + 8); sp = get16(p + 10); dn = get16(p + 12); dp = get16(p + 14);
+		if (sp == 0xfffe) sp = CTRL;
+		if (dp == 0xfffe) dp = CTRL;
+	} else goto bad;
+	if (dp == 0xffff) dp = CTRL;
+	if (at > len || !size || size > len - at || ((size + 3) & ~3u) != len - at) goto bad;
+	if ((dn != g->cfg.local_node && dn != BCAST) || sn == g->cfg.local_node || sn == BCAST) goto bad;
+	if (dp != CTRL && type != Q_DATA && type != Q_RESUME) goto bad;
+	if (type == Q_RESUME) return;
+	if (confirm) control(g, Q_RESUME, dp, sn, sp, dn, dp, 0, 0);
+	if (dp != CTRL && type == Q_DATA) {
+		for (i = 0; i < PORTS; i++) {
+			struct redwood_qrtr_port *port = &g->ports[i];
+			if (port->live && port->id == dp && port->receive) {
+				port->receive(port->ctx, sn, sp, p + at, size);
+				break;
+			}
+		}
+		return;
+	}
+	if (size < 20) goto bad;
+	p += at;
+	command = get32(p);
+	if (type != Q_DATA && command != type) goto bad;
+	switch (command) {
+	case Q_HELLO:
+		if (!g->hello) {
+			g->hello = true; g->peer = sn;
+			control(g, Q_HELLO, CTRL, sn, CTRL, 0, 0, 0, 0);
+			LOG(g, "mi8gl: qrtr hello from node %u\n", sn);
+		}
+		for (i = 0; i < PORTS; i++) if (g->ports[i].live && g->ports[i].published)
+			publish_notice(g, &g->ports[i], Q_NEW_SERVER, sn, CTRL);
+		break;
+	case Q_BYE:
+		drop_servers(g, sn);
+		if (g->peer == sn) { g->hello = false; g->peer = g->cfg.qrtr_node_hint; }
+		break;
+	case Q_NEW_SERVER:
+	case Q_DEL_SERVER: {
+		struct mi8_qrtr_server s;
+		int found = -1, empty = -1;
+		uint32_t packed = get32(p + 8);
+		s.service = get32(p + 4); s.version = packed & 255; s.instance = packed >> 8;
+		s.node = get32(p + 12); s.port = get32(p + 16);
+		if (!s.service || s.node == g->cfg.local_node || s.node == BCAST || !s.port || s.port >= CTRL) break;
+		for (i = 0; i < SERVERS; i++) {
+			if (!g->present[i]) { if (empty < 0) empty = (int)i; continue; }
+			if (g->servers[i].node == s.node && g->servers[i].port == s.port) { found = (int)i; break; }
+		}
+		if (found >= 0) {
+			struct mi8_qrtr_server old = g->servers[found];
+			bool same = old.service == s.service && old.version == s.version && old.instance == s.instance;
+			if (command == Q_NEW_SERVER && same) break;
+			if (command == Q_DEL_SERVER && !same) break;
+			g->present[found] = false;
+			announce(g, false, old);
+		} else if (command == Q_DEL_SERVER) break;
+		if (command == Q_NEW_SERVER) {
+			if (found < 0) found = empty;
+			if (found < 0) { broken(g, "server table exhausted"); break; }
+			g->servers[found] = s; g->present[found] = true;
+			LOG(g, "mi8gl: qrtr server: service %u version %u instance %u node %u port %u\n",
+			    s.service, s.version, s.instance, s.node, s.port);
+			announce(g, true, s);
+		}
+		break;
+	}
+	case Q_NEW_LOOKUP:
+		for (i = 0; i < PORTS; i++) {
+			struct redwood_qrtr_port *port = &g->ports[i];
+			uint32_t service = get32(p + 4), packed = get32(p + 8);
+			if (port->live && port->published && (!service || service == port->service) &&
+			    (!packed || packed == (port->version | port->instance << 8)))
+				publish_notice(g, port, Q_NEW_SERVER, sn, sp);
+		}
+		{
+			uint8_t end[20] = { 0 };
+			put32(end, Q_NEW_SERVER);
+			if (!queue_packet(g, sp == CTRL ? Q_NEW_SERVER : Q_DATA, CTRL, sn, sp, end, 20, false))
+				broken(g, "local lookup terminator queue exhausted");
+		}
+		break;
+	case Q_DEL_LOOKUP:
+		/* Remote lookups are snapshots; no remote subscription survives a request. */
+		break;
+	case Q_DEL_CLIENT:
+		for (i = 0; i < SERVERS; i++) if (g->present[i] && g->servers[i].node == get32(p + 4) &&
+		    g->servers[i].port == get32(p + 8)) {
+			struct mi8_qrtr_server s = g->servers[i];
+			g->present[i] = false; announce(g, false, s);
+		}
+		break;
+	default:
+		break;
+	}
+	return;
+bad:
+	LOG(g, "mi8gl: GLINK error: malformed QRTR packet dropped\n");
+}
+
+static void
+clear_intents(struct mi8_glink *g)
+{
+	unsigned i;
+	for (i = 0; i < INTENTS; i++) {
+		if (g->local[i].data) MI8_FREE(g->local[i].data, g->local[i].size);
+	}
+	memset(g->local, 0, sizeof(g->local));
+	memset(g->foreign, 0, sizeof(g->foreign));
+}
+
+static void
+open_channel(struct mi8_glink *g)
+{
+	static const uint32_t sizes[10] = { 0x800, 0x800, 0x800, 0x800, 0x800, 0x2000, 0x2000, 0x2000, 0x4400, 0x4400 };
+	unsigned i;
+	if (!g->agreed || !g->remote || g->closing) return;
+	if (!g->asked) {
+		g->asked = true;
+		say(g, OPEN, 1, 7, "IPCRTR", 7);
+	}
+	if (!g->acked || g->opened) return;
+	g->opened = true;
+	LOG(g, "mi8gl: IPCRTR open both ways\n");
+	for (i = 0; i < 10; i++) if (!offer(g, sizes[i], true)) {
+		broken(g, "initial intent allocation failed");
+		break;
+	}
+}
+
+static void
+pump(struct mi8_glink *g)
+{
+	unsigned budget = 256;
+	while (budget-- && g->up && !g->broken) {
+		uint8_t h[16], extra[40];
+		uint32_t head, tail, avail, cmd, cid, arg, n = 8, chunk = 0, left = 0;
+		unsigned i;
+		if (!marks(g, false, &head, &tail)) return;
+		avail = head >= tail ? head - tail : g->rx_size - tail + head;
+		if (avail < 8) return;
+		peek(g, tail, 0, h, 8);
+		cmd = get16(h); cid = get16(h + 2); arg = get32(h + 4);
+		if (cmd == OPEN) {
+			n += arg & 0xffff;
+			if (!(arg & 0xffff) || (arg & 0xffff) > 32) { broken(g, "bad channel name length"); return; }
+		} else if (cmd == INTENT) {
+			if (arg > (g->rx_size - 16) / 8) { broken(g, "bad intent count"); return; }
+			n += 8 * arg;
+		} else if (cmd == DATA || cmd == DATA_MORE) {
+			if (avail < 16) return;
+			peek(g, tail, 8, h + 8, 8);
+			chunk = get32(h + 8); left = get32(h + 12);
+			if (chunk > g->rx_size - 24) { broken(g, "oversized fragment"); return; }
+			n = 16 + chunk;
+		}
+		n = (n + 7) & ~7u;
+		if (n > g->rx_size - 8) { broken(g, "oversized frame"); return; }
+		if (avail < n) return;
+		if (cmd == OPEN) {
+			memset(extra, 0, sizeof(extra));
+			peek(g, tail, 8, extra, arg & 0xffff);
+			if (extra[(arg & 0xffff) - 1] != 0 || !cid) { broken(g, "bad channel name or id"); return; }
+		}
+		if (cmd == INTENT && cid == g->remote) {
+			for (i = 0; i < arg; i++) {
+				uint32_t size, id;
+				unsigned j;
+				peek(g, tail, 8 + 8 * i, extra, 8);
+				size = get32(extra); id = get32(extra + 4);
+				/* Linux does not refuse these: the modem's firmware numbers its intents from 0 (EXP-0200); a zero size is of no use, skip it */
+				LOG(g, "mi8gl: remote intent id %u size %u (%s)\n", id, size, g->cfg.name);
+				if (!size) continue;
+				for (j = 0; j < INTENTS; j++) if (g->foreign[j].there && g->foreign[j].id == id) break;
+				if (j < INTENTS) {
+					if (g->foreign[j].busy || g->foreign[j].size != size) { broken(g, "conflicting remote intent"); return; }
+					continue;
+				}
+				for (j = 0; j < INTENTS; j++) if (!g->foreign[j].there) break;
+				if (j == INTENTS) { broken(g, "remote intent table exhausted"); return; }
+				g->foreign[j].there = true; g->foreign[j].id = id; g->foreign[j].size = size;
+			}
+		}
+		if ((cmd == DATA || cmd == DATA_MORE) && cid == g->remote && g->opened) {
+			struct intent *v = NULL;
+			uint8_t *packet = NULL;
+			uint32_t total = 0;
+			for (i = 0; i < INTENTS; i++) if (g->local[i].there && g->local[i].id == arg) { v = &g->local[i]; break; }
+			if (!v || !chunk || chunk > v->size - v->fill || left > v->size - v->fill - chunk ||
+			    (cmd == DATA && v->busy) || (cmd == DATA_MORE && (!v->busy || v->left != chunk + left))) {
+				broken(g, "invalid fragment sequence or intent"); return;
+			}
+			peek(g, tail, 16, v->data + v->fill, chunk);
+			v->fill += chunk; v->left = left; v->busy = left != 0;
+			if (!left) {
+				total = v->fill;
+				packet = MI8_ALLOC(total);
+				if (!packet) { broken(g, "receive allocation failed"); return; }
+				memcpy(packet, v->data, total);
+				v->fill = 0;
+			}
+			write_word(g, g->desc + 8, (tail + n) % g->rx_size);
+			if (!left) {
+				say(g, v->reusable ? DONE_REUSE : DONE, 1, arg, NULL, 0);
+				if (!v->reusable) {
+					MI8_FREE(v->data, v->size); memset(v, 0, sizeof(*v));
+				}
+				qrtr_input(g, packet, total);
+				MI8_FREE(packet, total);
+			}
+			continue;
+		}
+		write_word(g, g->desc + 8, (tail + n) % g->rx_size);
+		switch (cmd) {
+		case VERSION:
+			if (!cid) { broken(g, "remote has no version"); break; }
+			if (cid == 1) g->features &= arg;
+			say(g, VERSION_ACK, 1, g->features, NULL, 0);
+			break;
+		case VERSION_ACK:
+			if (!cid) { broken(g, "version negotiation rejected"); break; }
+			if (cid == 1 && arg == g->features) g->agreed = true;
+			else { g->features &= arg; say(g, VERSION, 1, g->features, NULL, 0); }
+			break;
+		case OPEN:
+			say(g, OPEN_ACK, cid, 0, NULL, 0);
+			if ((arg & 0xffff) == 7 && !memcmp(extra, "IPCRTR", 7)) {
+				if (g->remote && g->remote != cid) { broken(g, "IPCRTR channel changed without close"); break; }
+				g->remote = cid;
+			} else LOG(g, "mi8gl: unsupported remote channel %u %s: acknowledged, data ignored\n", cid, extra);
+			break;
+		case OPEN_ACK:
+			if (cid == 1 && g->asked && !g->closing) g->acked = true;
+			break;
+		case INTENT: break;
+		case INTENT_REQ:
+			if (cid == g->remote && g->opened) {
+				bool granted = offer(g, arg, false);
+				say(g, INTENT_ACK, 1, granted ? 1 : 0, NULL, 0);
+			}
+			break;
+		case INTENT_ACK:
+			if (cid == g->remote && g->outgoing && g->outgoing->requested) {
+				g->outgoing->answered = true; g->outgoing->granted = arg != 0;
+				if (g->outgoing->length > 1000) LOG(g, "mi8gl: the modem %s the intent request for %u bytes\n", arg ? "grants" : "REFUSES", g->outgoing->length);
+			}
+			break;
+		case DONE:
+		case DONE_REUSE:
+			if (cid == g->remote) for (i = 0; i < INTENTS; i++) if (g->foreign[i].there && g->foreign[i].id == arg) {
+				/* The modem can answer before emit() has returned and offset has been counted (it is quick, EXP-0200): not an error. */
+				if (g->foreign[i].size > 1000) LOG(g, "mi8gl: remote done with intent %u (size %u), %s\n", arg, g->foreign[i].size, cmd == DONE_REUSE ? "reusable" : "gone");
+				g->foreign[i].busy = false;
+				g->foreign[i].there = cmd == DONE_REUSE;
+				break;
+			}
+			break;
+		case READ_NOTIFY:
+			g->cfg.ring(g->cfg.ctx);
+			break;
+		case CLOSE:
+			say(g, CLOSE_ACK, cid, 0, NULL, 0);
+			if (cid == g->remote) {
+				g->remote = 0; g->opened = false; g->hello = false;
+				if (g->asked && !g->closing) { g->closing = true; say(g, CLOSE, 1, 0, NULL, 0); }
+				while (g->outgoing) finish(g, ENOTCONN);
+				clear_intents(g); drop_servers(g, BCAST);
+			}
+			break;
+		case CLOSE_ACK:
+			if (cid == 1 && g->closing) { g->closing = false; g->asked = false; g->acked = false; }
+			break;
+		case DATA:
+		case DATA_MORE:
+		case SIGNALS:
+			break;
+		default: broken(g, "unknown command"); break;
+		}
+		open_channel(g);
+	}
+}
+
+static struct redwood_qrtr_port *
+open_slot(unsigned slot, redwood_qrtr_receive_t receive, redwood_qrtr_server_t server, void *ctx)
+{
+	struct mi8_glink *g = __atomic_load_n(&instances[slot], __ATOMIC_ACQUIRE);
+	struct redwood_qrtr_port *p = NULL;
+	unsigned i;
+	if (!g) return NULL;
+	enter(g);
+	if (g->up && !g->broken && g->next_port < 0xfffd) for (i = 0; i < PORTS; i++) if (!g->ports[i].live) {
+		p = &g->ports[i];
+		memset(p->lookups, 0, sizeof(p->lookups));
+		p->g = g; p->id = ++g->next_port; p->generation++;
+		p->receive = receive; p->server = server; p->ctx = ctx; p->live = true;
+		p->published = false;
+		break;
+	}
+	leave(g);
+	return p;
+}
+
+static int
+send_port(struct redwood_qrtr_port *p, uint32_t node, uint32_t port, const void *data, size_t length)
+{
+	struct mi8_glink *g;
+	struct outgoing *o;
+	int error;
+	if (!p || (!data && length) || !length) return EINVAL;
+	if (length > MI8_GLINK_MAX_DATAGRAM) return EMSGSIZE;
+	g = p->g; enter(g);
+	if (!p->live || !g->up || !g->opened || g->broken) { leave(g); return ENOTCONN; }
+	if (node == g->cfg.local_node || node == BCAST || !port || port >= CTRL) { leave(g); return EINVAL; }
+	o = queue_packet(g, Q_DATA, p->id, node, port, data, (uint32_t)length, true);
+	if (!o) { leave(g); return ENOMEM; }
+	do {
+		pump(g); progress(g);
+		if (!o->done) g->cfg.sleep_us(g->cfg.ctx, 1000);
+	} while (!o->done);
+	error = o->error;
+	MI8_FREE(o, sizeof(*o) + o->length);
+	leave(g);
+	return error;
+}
+
+static int
+lookup_port(struct redwood_qrtr_port *p, uint32_t service, uint32_t version, uint32_t instance)
+{
+	struct mi8_glink *g;
+	struct lookup *l = NULL;
+	struct mi8_qrtr_server snapshot[SERVERS];
+	unsigned i, count = 0;
+	uint32_t generation;
+	if (!p || version > 255 || instance > 0xffffff) return EINVAL;
+	g = p->g; enter(g);
+	if (!p->live || !g->up || g->broken) { leave(g); return ENOTCONN; }
+	for (i = 0; i < LOOKUPS; i++) {
+		if (!p->lookups[i].used) { if (!l) l = &p->lookups[i]; continue; }
+		if (p->lookups[i].service == service && p->lookups[i].version == version && p->lookups[i].instance == instance) {
+			leave(g); return 0;
+		}
+	}
+	if (!l) { leave(g); return ENOSPC; }
+	l->used = true; l->service = service; l->version = version; l->instance = instance;
+	generation = p->generation;
+	for (i = 0; i < SERVERS; i++) if (g->present[i] && matches(l, &g->servers[i])) snapshot[count++] = g->servers[i];
+	for (i = 0; i < count && p->live && p->generation == generation && p->server; i++) {
+		struct mi8_qrtr_server s = snapshot[i];
+		p->server(p->ctx, true, s.service, s.version, s.instance, s.node, s.port);
+	}
+	leave(g);
+	return 0;
+}
+
+static void
+close_port(struct redwood_qrtr_port *p)
+{
+	struct mi8_glink *g;
+	if (!p) return;
+	g = p->g; enter(g);
+	if (p->live) {
+		if (p->published && g->up && g->opened && g->hello && !g->broken)
+			publish_notice(g, p, Q_DEL_SERVER, g->peer, CTRL);
+		p->published = false;
+		p->live = false; p->generation++;
+		memset(p->lookups, 0, sizeof(p->lookups));
+		if (g->up && g->opened && !g->broken)
+			control(g, Q_DEL_CLIENT, p->id, (g->hello || g->peer) ? g->peer : BCAST, CTRL, g->cfg.local_node, p->id, 0, 0);
+		progress(g);
+	}
+	leave(g);
+}
+
+#define SLOT(n) static struct redwood_qrtr_port *open_##n(redwood_qrtr_receive_t r, redwood_qrtr_server_t s, void *c) \
+	{ return open_slot(n, r, s, c); }
+SLOT(0) SLOT(1) SLOT(2) SLOT(3) SLOT(4) SLOT(5) SLOT(6) SLOT(7)
+#define OPS(n) { open_##n, send_port, lookup_port, close_port }
+static const struct redwood_qrtr_ops all_ops[INSTANCES] = { OPS(0), OPS(1), OPS(2), OPS(3), OPS(4), OPS(5), OPS(6), OPS(7) };
+
+struct mi8_glink *
+mi8_glink_create(const struct mi8_glink_cfg *cfg)
+{
+	struct mi8_glink *g;
+	unsigned i;
+	if (!cfg || !cfg->name || !cfg->smem_item || !cfg->smem_read || !cfg->smem_write32 ||
+	    !cfg->ring || !cfg->sleep_us || !cfg->now_us) return NULL;
+	g = MI8_ALLOC(sizeof(*g));
+	if (!g) return NULL;
+	memset(g, 0, sizeof(*g)); g->cfg = *cfg;
+	if (!g->cfg.local_node) g->cfg.local_node = 1;
+	if (g->cfg.local_node >= CTRL) { MI8_FREE(g, sizeof(*g)); return NULL; }
+	for (i = 0; i < INSTANCES; i++) {
+		struct mi8_glink *empty = NULL;
+		if (__atomic_compare_exchange_n(&instances[i], &empty, g, false, __ATOMIC_RELEASE, __ATOMIC_RELAXED)) {
+			g->slot = i;
+			return g;
+		}
+	}
+	MI8_FREE(g, sizeof(*g));
+	return NULL;
+}
+
+int
+mi8_glink_start(struct mi8_glink *g)
+{
+	uint32_t size, ends[3], bases[3];
+	unsigned i, j;
+	int error = 0;
+	if (!g) return EINVAL;
+	enter(g);
+	if (g->up) { leave(g); return EALREADY; }
+	if (!g->cfg.smem_item(g->cfg.ctx, 478, &g->desc, &size) || size != 32) {
+		LOG(g, "mi8gl: no descriptor (%s pid %u)\n", g->cfg.name, g->cfg.remote_pid);
+		error = ENOENT; goto out;
+	}
+	if (!g->cfg.smem_item(g->cfg.ctx, 479, &g->tx, &g->tx_size) ||
+	    !g->cfg.smem_item(g->cfg.ctx, 480, &g->rx, &g->rx_size)) { error = ENOENT; goto bad; }
+	if ((g->desc & 3) || ((g->tx | g->rx | g->tx_size | g->rx_size) & 7) ||
+	    g->tx_size < 64 || g->rx_size < 64 || g->tx_size > 0x200000 || g->rx_size > 0x200000) {
+		error = EINVAL; goto bad;
+	}
+	bases[0] = g->desc; bases[1] = g->tx; bases[2] = g->rx;
+	ends[0] = g->desc + 32; ends[1] = g->tx + g->tx_size; ends[2] = g->rx + g->rx_size;
+	for (i = 0; i < 3; i++) {
+		if (ends[i] < bases[i]) { error = EINVAL; goto bad; }
+		for (j = 0; j < i; j++) if (bases[i] < ends[j] && bases[j] < ends[i]) { error = EINVAL; goto bad; }
+	}
+	g->broken = false; g->up = true; g->features = 1; g->peer = g->cfg.qrtr_node_hint;
+	g->next_port = 0x3fff;
+	write_word(g, g->desc + 4, 0);
+	write_word(g, g->desc + 8, 0);
+	say(g, VERSION, 1, g->features, NULL, 0);
+	if (g->broken) error = EIO;
+	goto out;
+bad:
+	LOG(g, "mi8gl: GLINK error: invalid or missing FIFO\n");
+out:
+	leave(g);
+	return error;
+}
+
+void
+mi8_glink_poll_once(struct mi8_glink *g)
+{
+	if (!g) return;
+	enter(g);
+	if (g->up) { pump(g); progress(g); }
+	leave(g);
+}
+
+void
+mi8_glink_stop(struct mi8_glink *g)
+{
+	struct command *c;
+	unsigned i;
+	if (!g) return;
+	enter(g);
+	for (i = 0; i < PORTS; i++) {
+		g->ports[i].published = false;
+		g->ports[i].live = false; g->ports[i].generation++;
+		memset(g->ports[i].lookups, 0, sizeof(g->ports[i].lookups));
+	}
+	if (g->up && g->asked && !g->closing) say(g, CLOSE, 1, 0, NULL, 0);
+	g->up = false;
+	while (g->outgoing) finish(g, ENOTCONN);
+	while ((c = g->commands) != NULL) { g->commands = c->next; MI8_FREE(c, sizeof(*c)); }
+	g->command_last = NULL; g->command_count = 0;
+	clear_intents(g);
+	memset(g->present, 0, sizeof(g->present));
+	g->agreed = g->asked = g->acked = g->opened = g->closing = g->hello = g->notified = false;
+	g->remote = 0;
+	leave(g);
+}
+
+void
+mi8_glink_destroy(struct mi8_glink *g)
+{
+	if (!g) return;
+	mi8_glink_stop(g);
+	__atomic_store_n(&instances[g->slot], NULL, __ATOMIC_RELEASE);
+	MI8_FREE(g, sizeof(*g));
+}
+
+const struct redwood_qrtr_ops *
+mi8_glink_qrtr_ops(struct mi8_glink *g)
+{
+	return g ? &all_ops[g->slot] : NULL;
+}
+
+int
+mi8_glink_qrtr_publish(struct mi8_glink *g, struct redwood_qrtr_port *p,
+    uint32_t service, uint32_t version, uint32_t instance)
+{
+	int error = 0;
+	if (!g || !p || p->g != g || !service || version > 255 || instance > 0xffffff) return EINVAL;
+	enter(g);
+	if (!g->up || g->broken || !p->live) { error = ENOTCONN; goto out; }
+	if (p->published && p->service == service && p->version == version && p->instance == instance) goto out;
+	if (p->published && g->hello && g->opened) publish_notice(g, p, Q_DEL_SERVER, g->peer, CTRL);
+	p->service = service; p->version = version; p->instance = instance; p->published = true;
+	if (g->hello && g->opened) publish_notice(g, p, Q_NEW_SERVER, g->peer, CTRL);
+	if (g->broken) error = EIO;
+out:
+	leave(g);
+	return error;
+}
+
+int
+mi8_glink_qrtr_servers(struct mi8_glink *g, struct mi8_qrtr_server *out, unsigned max)
+{
+	unsigned i, count = 0;
+	if (!g || (!out && max)) return -EINVAL;
+	enter(g);
+	for (i = 0; i < SERVERS && count < max; i++) if (g->present[i]) out[count++] = g->servers[i];
+	leave(g);
+	return (int)count;
+}
