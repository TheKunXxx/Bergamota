+
+struct redwood_qrtr_port;
+typedef void (*redwood_qrtr_receive_t)(void *, uint32_t, uint32_t, const void *, size_t);
+typedef void (*redwood_qrtr_server_t)(void *, bool, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t);
+struct redwood_qrtr_ops {
+	struct redwood_qrtr_port *(*open)(redwood_qrtr_receive_t, redwood_qrtr_server_t, void *);
+	int (*send)(struct redwood_qrtr_port *, uint32_t, uint32_t, const void *, size_t);
+	int (*lookup)(struct redwood_qrtr_port *, uint32_t, uint32_t, uint32_t);
+	void (*close)(struct redwood_qrtr_port *);
+};
+
+struct mi8_glink_cfg {
+	const char *name;
+	uint32_t remote_pid;
+	uint32_t qrtr_node_hint;
+	bool (*smem_item)(void *, uint32_t, uint32_t *, uint32_t *);
+	void (*smem_read)(void *, uint32_t, void *, uint32_t);
+	void (*smem_write32)(void *, uint32_t, uint32_t);
+	void (*ring)(void *);
+	void (*sleep_us)(void *, uint32_t);
+	uint64_t (*now_us)(void *);
+	void (*log)(void *, const char *, ...);
+	void *ctx;
+	uint32_t local_node; /* Zero selects the default node 1. */
+};
+
+struct mi8_qrtr_server {
+	uint32_t service, version, instance, node, port;
+};
+
+#define MI8_GLINK_MAX_DATAGRAM (65536u - 32u)
+struct mi8_glink;
+struct mi8_glink *mi8_glink_create(const struct mi8_glink_cfg *);
+int mi8_glink_start(struct mi8_glink *);
+void mi8_glink_poll_once(struct mi8_glink *);
+void mi8_glink_stop(struct mi8_glink *);
+/* Quiesce callers and discard all port/ops handles before destroying an instance. */
+void mi8_glink_destroy(struct mi8_glink *);
+const struct redwood_qrtr_ops *mi8_glink_qrtr_ops(struct mi8_glink *);
+/* Returns the number copied, or a positive errno negated for invalid arguments. */
+int mi8_glink_qrtr_servers(struct mi8_glink *, struct mi8_qrtr_server *, unsigned);
+int mi8_glink_qrtr_publish(struct mi8_glink *, struct redwood_qrtr_port *, uint32_t, uint32_t, uint32_t);
+
+/*
+ * Callbacks and API calls are serialized by a recursive, sleeping instance gate.
+ * Callbacks may call send/lookup/close; they must not wait for another caller to
+ * enter this instance. Lifecycle calls (start/stop/destroy) are outside callbacks.
+ * SMEM callbacks must implement ordered device-memory access; see NOTES.md.
