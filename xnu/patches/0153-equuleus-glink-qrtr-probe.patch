+/* 0153: bounded dipper GLINK/QRTR transport probe. No RMTFS, file service or WLFW. */
+static bool mss_glink_test;
+struct eq_glink_io {
+	uint32_t base[3], size[3]; /* descriptor, host TX, modem TX */
+	bool fault;
+};
+
+static bool
+eq_glink_range(uint32_t offset, uint32_t n, uint32_t base, uint32_t size)
+{
+	return base <= SMEM_SIZE && size <= SMEM_SIZE - base &&
+	    offset >= base && offset - base <= size && n <= size - (offset - base);
+}
+
+static bool
+eq_glink_item(void *arg, uint32_t item, uint32_t *offset, uint32_t *size)
+{
+	struct eq_glink_io *io = arg;
+	if (item < 478 || item > 480) { return false; }
+	*offset = io->base[item - 478]; *size = io->size[item - 478];
+	return *offset != 0;
+}
+
+static void
+eq_glink_read(void *arg, uint32_t offset, void *out, uint32_t n)
+{
+	struct eq_glink_io *io = arg;
+	for (unsigned i = 0; !io->fault && i < 3; i++) {
+		if (eq_glink_range(offset, n, io->base[i], io->size[i]) && smem_peek(offset, out, n)) {
+			settle(); return;
+		}
+	}
+	io->fault = true; bzero(out, n);
+}
+
+static void
+eq_glink_write(void *arg, uint32_t offset, uint32_t value)
+{
+	struct eq_glink_io *io = arg;
+	if (!io->fault && !(offset & 3) &&
+	    (offset == io->base[0] + 4 || offset == io->base[0] + 8 ||
+	     eq_glink_range(offset, 4, io->base[1], io->size[1]))) {
+		smem_poke(offset, value); settle(); return;
+	}
+	io->fault = true;
+}
+
+static void
+eq_glink_ring(void *arg)
+{
+	struct eq_glink_io *io = arg;
+	if (!io->fault) { settle(); ring(IPC_GLINK_MODEM); }
+}
+
+static void
+eq_glink_sleep(void *arg, uint32_t us)
+{
+	(void)arg; delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static uint64_t
+eq_glink_now(void *arg)
+{
+	(void)arg; return now_us();
+}
+
+static void
+eq_glink_log(void *arg, const char *format, ...)
+{
+	char line[320]; va_list ap;
+	(void)arg; va_start(ap, format); vsnprintf(line, sizeof(line), format, ap); va_end(ap);
+	say("eqgl: %s", line);
+}
+
+static bool
+eq_glink_layout(struct eq_glink_io *io)
+{
+	bzero(io, sizeof(*io));
+	for (unsigned i = 0; i < 3; i++) {
+		io->base[i] = adsp_item(478 + i, &io->size[i]);
+		if (!io->base[i] || !eq_glink_range(io->base[i], io->size[i], 0, SMEM_SIZE)) { return false; }
+		if (i == 0) {
+			if (io->size[i] != 32 || (io->base[i] & 3)) { return false; }
+		} else if ((io->base[i] | io->size[i]) & 7 || io->size[i] < 64 || io->size[i] > 0x20000) { return false; }
+		for (unsigned j = 0; j < i; j++) {
+			if (io->base[i] < io->base[j] + io->size[j] && io->base[j] < io->base[i] + io->size[i]) { return false; }
+		}
+	}
+	return true;
+}
+
+void
+equuleus_glink_probe(void)
+{
+	struct eq_glink_io io;
+	struct mi8_glink_cfg cfg;
+	struct mi8_glink *g = NULL;
+	struct mi8_qrtr_server servers[64];
+	uint64_t began = now_us();
+	bool started = false;
+	int result = ENOENT;
+
+	say("eqgl: mode8: GLINK/QRTR for at most 10 seconds; no host file services\n");
+	bzero(&io, sizeof(io)); bzero(&cfg, sizeof(cfg));
+	for (unsigned poll = 0; poll < 20000 && now_us() - began < 10000000ull; poll++) {
+		if (poll % 200 == 0) {
+			struct smp2p state;
+			if (!dsp_words(&state) || (dsp_state(&state) & DSP_FATAL)) { result = EIO; break; }
+			dsp_listen(&state);
+		}
+		if (!started && eq_glink_layout(&io)) {
+			cfg.name = "equuleus-modem"; cfg.remote_pid = SMEM_MODEM; cfg.ctx = &io;
+			cfg.smem_item = eq_glink_item; cfg.smem_read = eq_glink_read; cfg.smem_write32 = eq_glink_write;
+			cfg.ring = eq_glink_ring; cfg.sleep_us = eq_glink_sleep; cfg.now_us = eq_glink_now; cfg.log = eq_glink_log;
+			g = mi8_glink_create(&cfg);
+			if (!g) { result = ENOMEM; break; }
+			say("eqgl: items desc %#x/%u tx %#x/%u rx %#x/%u\n", io.base[0], io.size[0], io.base[1], io.size[1], io.base[2], io.size[2]);
+			result = mi8_glink_start(g);
+			if (result) { break; }
+			started = true;
+		}
+		if (started) {
+			mi8_glink_poll_once(g);
+			if (io.fault) { result = EFAULT; break; }
+		}
+		delay_for_interval(500, NSEC_PER_USEC);
+	}
+	if (g) {
+		int n = mi8_glink_qrtr_servers(g, servers, 64);
+		say("eqgl: transport start=%u result=%d io_fault=%u servers=%d\n", started ? 1u : 0u, result, io.fault ? 1u : 0u, n);
+		for (int i = 0; i < n; i++) {
+			say("eqgl: service %u version %u instance %u node %u port %u\n", servers[i].service, servers[i].version, servers[i].instance, servers[i].node, servers[i].port);
+		}
+		mi8_glink_destroy(g);
+	} else { say("eqgl: transport not started result=%d (items478/479/480 required)\n", result); }
+	say("eqgl: bounded probe ended; existing cooperative stop/halt guard follows\n");
 }
 
