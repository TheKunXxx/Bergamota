+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+ * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ * SOFTWARE.
+ * RMTFS wire semantics adapted from dipper-xnu 4e82c709ea42ebb509fa101b52972fdc890b873e.
+ * Equuleus RMTFS: pinned wire semantics, complete RAM snapshots, bounded polling and replay.
+ */
+#include "equuleus_rmtfs.h"
+#ifdef EQ_RMTFS_HOST_TEST
+#include <stdlib.h>
+#include <string.h>
+#ifndef RMT_ALLOC
+#define RMT_ALLOC(n) calloc(1,n)
+#define RMT_FREE(p,n) free(p)
+#endif
+#else
+#include <kern/kalloc.h>
+#include <libkern/libkern.h>
+#define RMT_ALLOC(n) kalloc_data(n,Z_WAITOK|Z_ZERO)
+#define RMT_FREE(p,n) kfree_data(p,n)
+#endif
+#define RMT_MAX 8192u
+#define RMT_HANDLES 32u
+#define RMT_QUEUE 8u
+#define RMT_CACHE 16u
+#define RMT_LIMIT 4096u
+/* QMI error numbers and OPEN/CLOSE/RW/ALLOC/DEVERR/SYNC messages from donor. */
+enum { R_OK=0,R_MALFORMED=1,R_NOMEM=2,R_INTERNAL=3,R_BAD_HANDLE=9,R_INVALID=48,R_UNSUPPORTED=94 };
+struct rmt_tlv {const uint8_t *p;unsigned n;};
+struct rmt_handle {uint32_t id,node;unsigned part;bool live;};
+struct rmt_request {struct rmt_request *next;uint32_t node,port,n;uint8_t data[];};
+struct rmt_replay {uint32_t node,port,n,rn;uint8_t request[RMT_MAX],response[32];};
+struct equuleus_rmtfs {
+ struct equuleus_rmtfs_cfg cfg;
+ const struct redwood_qrtr_ops *ops;struct redwood_qrtr_port *port;
+ uint8_t *shadow[6];
+ struct rmt_handle handles[RMT_HANDLES];
+ struct rmt_request *head,*tail;
+ struct rmt_replay cache[RMT_CACHE];
+ uint32_t next_id,queued,requests,replies,rejected,replayed,reads,writes,cache_next;
+ bool started,dispatching;
+};
+static const char *const rmt_names[]={"modemst1","modemst2","fsg","fsc"};
+static const uint32_t rmt_sizes[]={0x800000,0x800000,0x800000,0x40000,0x100000,0x100000};
+static const char *const rmt_paths[]={"/boot/modem_fs1","/boot/modem_fs2","/boot/modem_fsg","/boot/modem_fsc","/boot/modem_fsg_oem_1","/boot/modem_fsg_oem_2"};
+static uint64_t rmt_le(const uint8_t *p,unsigned n){uint64_t v=0;for(unsigned i=0;i<n;i++)v|=(uint64_t)p[i]<<(8*i);return v;}
+static void rmt_put(uint8_t *p,uint64_t v,unsigned n){for(unsigned i=0;i<n;i++)p[i]=(uint8_t)(v>>(8*i));}
+static void rmt_wipe(void *p,size_t n){volatile uint8_t *v=p;while(n--)*v++=0;}
+static bool rmt_parse(const uint8_t *p,unsigned n,struct rmt_tlv *t){
+ memset(t,0,256*sizeof(*t));
+ while(n){if(n<3)return false;unsigned tag=p[0],len=(unsigned)rmt_le(p+1,2);if(len>n-3 || t[tag].p)return false;t[tag].p=p+3;t[tag].n=len;p+=3+len;n-=3+len;}
+ return true;
+}
+static bool rmt_has(const struct rmt_tlv *t,unsigned tag,unsigned n){return t[tag].p && t[tag].n==n;}
+static unsigned rmt_run(struct equuleus_rmtfs *r,uint32_t node,unsigned msg,const struct rmt_tlv *t,uint8_t *reply,unsigned *length){
+ if(msg==1){
+  unsigned part=6;
+  if(!t[1].p || !t[1].n || t[1].n>255)return R_MALFORMED;
+  for(unsigned i=0;i<6;i++)if(strlen(rmt_paths[i])==t[1].n && !memcmp(rmt_paths[i],t[1].p,t[1].n)){part=i;break;}
+  if(part==6)return R_INVALID;
+  unsigned slot=RMT_HANDLES;for(unsigned i=0;i<RMT_HANDLES;i++)if(!r->handles[i].live){slot=i;break;}
+  if(slot==RMT_HANDLES || r->next_id==UINT32_MAX)return R_NOMEM;
+  struct rmt_handle *h=&r->handles[slot];h->id=++r->next_id;h->node=node;h->part=part;h->live=true;
+  reply[14]=0x10;rmt_put(reply+15,4,2);rmt_put(reply+17,h->id,4);*length=21;
+  if(r->cfg.log)r->cfg.log(r->cfg.ctx,"eqrf: open partition_index=%u handle=%u (RAM only)\n",part,h->id);
+  return R_OK;
+ }
+ if(msg<2 || msg>6)return R_UNSUPPORTED;
+ if(!rmt_has(t,1,4))return R_MALFORMED;
+ uint32_t id=(uint32_t)rmt_le(t[1].p,4);
+ if(msg==4){
+  if(!rmt_has(t,2,4))return R_MALFORMED;
+  uint32_t n=(uint32_t)rmt_le(t[2].p,4);
+  /* DT qcom,client-id=1. The field is NOT an OPEN handle. */
+  if(id!=1 || !n || n>r->cfg.size)return R_INVALID;
+  reply[14]=0x10;rmt_put(reply+15,8,2);rmt_put(reply+17,r->cfg.physical,8);*length=25;
+  if(r->cfg.log)r->cfg.log(r->cfg.ctx,"eqrf: alloc client=%u bytes=%u\n",id,n);
+  return R_OK;
+ }
+ struct rmt_handle *h=NULL;
+ /* Real modem moves requests between QRTR ports; bind handles to node, not port. */
+ for(unsigned i=0;i<RMT_HANDLES;i++)if(r->handles[i].live && r->handles[i].id==id && r->handles[i].node==node){h=&r->handles[i];break;}
+ if(!h)return R_BAD_HANDLE;
+ if(msg==3){
+  if(!rmt_has(t,2,1) || !t[3].p || !t[3].n || (t[4].p && !rmt_has(t,4,1)))return R_MALFORMED;
+  unsigned direction=t[2].p[0],count=t[3].p[0];uint64_t total=0;
+  if(direction>1 || !count || t[3].n!=1+12*count)return R_INVALID;
+  /* Validate ALL vectors before changing any byte; offsets are in 512B sectors. */
+  for(unsigned i=0;i<count;i++){
+   const uint8_t *v=t[3].p+1+12*i;
+   uint64_t offset=rmt_le(v,4)*512,physical=rmt_le(v+4,4),bytes=rmt_le(v+8,4)*512;
+   if(!bytes || offset>rmt_sizes[h->part] || bytes>rmt_sizes[h->part]-offset || physical<r->cfg.physical || physical-r->cfg.physical>r->cfg.size || bytes>r->cfg.size-(physical-r->cfg.physical) || total>r->cfg.size || bytes>r->cfg.size-total)return R_INVALID;
+   total+=bytes;
+  }
+  __sync_synchronize();
+  for(unsigned i=0;i<count;i++){
+   const uint8_t *v=t[3].p+1+12*i;size_t offset=(size_t)(rmt_le(v,4)*512),bytes=(size_t)(rmt_le(v+8,4)*512);
+   uint8_t *shared=(uint8_t *)r->cfg.shared+(rmt_le(v+4,4)-r->cfg.physical);
+   if(direction)memcpy(shared,r->shadow[h->part]+offset,bytes);
+   else memcpy(r->shadow[h->part]+offset,shared,bytes);
+  }
+  __sync_synchronize();if(direction)r->reads++;else r->writes++;
+  if(r->cfg.log && r->reads+r->writes<=20)r->cfg.log(r->cfg.ctx,"eqrf: rw dir=%u vectors=%u bytes=%llu (RAM only)\n",direction,count,(unsigned long long)total);
+ } else if(msg==2)h->live=false;
+ else if(msg==5){reply[14]=0x10;rmt_put(reply+15,4,2);rmt_put(reply+17,0,4);*length=21;}
+ /* SYNC acknowledges RAM state only; no persistent writer exists. */
+ return R_OK;
+}
+static void rmt_receive(void *ctx,uint32_t node,uint32_t port,const void *data,size_t n){
+ struct equuleus_rmtfs *r=ctx;
+ if(!r->started)return;
+ if(node!=0 || !port || port>=0xfffffffeu || !data || n<7 || n>RMT_MAX || r->queued>=RMT_QUEUE || r->requests>=RMT_LIMIT){r->rejected++;return;}
+ struct rmt_request *q=RMT_ALLOC(sizeof(*q)+n);if(!q){r->rejected++;return;}
+ q->next=NULL;q->node=node;q->port=port;q->n=(uint32_t)n;memcpy(q->data,data,n);
+ if(r->tail)r->tail->next=q;else r->head=q;r->tail=q;r->queued++;r->requests++;
+}
+void equuleus_rmtfs_poll(struct equuleus_rmtfs *r){
+ if(!r || !r->started || r->dispatching || !r->head)return;
+ r->dispatching=true;struct rmt_request *q=r->head;r->head=q->next;if(!r->head)r->tail=NULL;
+ uint8_t response[32]={0};unsigned rn=14,error=R_MALFORMED;bool cached=false;
+ /* Validate request flag/length before lookup or dispatch. */
+ if(q->data[0]!=0){r->rejected++;goto done;}
+ for(unsigned i=0;i<RMT_CACHE;i++){
+  struct rmt_replay *c=&r->cache[i];
+  if(c->n==q->n && c->node==q->node && c->port==q->port && !memcmp(c->request,q->data,q->n)){rn=c->rn;memcpy(response,c->response,rn);cached=true;r->replayed++;break;}
+ }
+ if(!cached){
+  response[0]=2;memcpy(response+1,q->data+1,4);
+  struct rmt_tlv *t=RMT_ALLOC(256*sizeof(*t));
+  if(!t)error=R_NOMEM;
+  else{
+   if(rmt_le(q->data+5,2)==q->n-7 && rmt_parse(q->data+7,q->n-7,t))error=rmt_run(r,q->node,(unsigned)rmt_le(q->data+3,2),t,response,&rn);
+   RMT_FREE(t,256*sizeof(*t));
+  }
+  if(error)rn=14;
+  response[7]=2;rmt_put(response+8,4,2);rmt_put(response+10,error?1:0,2);rmt_put(response+12,error,2);rmt_put(response+5,rn-7,2);
+  if(error!=R_NOMEM){struct rmt_replay *c=&r->cache[r->cache_next++%RMT_CACHE];c->node=q->node;c->port=q->port;c->n=q->n;c->rn=rn;memcpy(c->request,q->data,q->n);memcpy(c->response,response,rn);}
+  if(error){r->rejected++;if(r->cfg.log && r->rejected<=20)r->cfg.log(r->cfg.ctx,"eqrf: request msg=%u error=%u\n",(unsigned)rmt_le(q->data+3,2),error);}
+ }
+ if(r->replies<RMT_LIMIT){r->replies++;int result=r->ops->send(r->port,q->node,q->port,response,rn);if(result && r->cfg.log)r->cfg.log(r->cfg.ctx,"eqrf: send errno=%d\n",result);}
+done:
+ r->queued--;RMT_FREE(q,sizeof(*q)+q->n);r->dispatching=false;
+}
+struct equuleus_rmtfs *equuleus_rmtfs_create(const struct equuleus_rmtfs_cfg *cfg){
+ if(!cfg || !cfg->shared || !cfg->physical || !cfg->part_size || !cfg->part_read || cfg->size!=0x200000 || (cfg->physical&0x3fff) || cfg->physical>0x100000000ull-cfg->size)return NULL;
+ struct equuleus_rmtfs *r=RMT_ALLOC(sizeof(*r));if(!r)return NULL;memset(r,0,sizeof(*r));r->cfg=*cfg;
+ for(unsigned i=0;i<6;i++){
+  if(i<4){uint64_t size=0;if(cfg->part_size(cfg->ctx,rmt_names[i],&size) || size!=rmt_sizes[i])goto fail;}
+  r->shadow[i]=RMT_ALLOC(rmt_sizes[i]);if(!r->shadow[i])goto fail;memset(r->shadow[i],0,rmt_sizes[i]);
+  if(i<4)for(uint64_t offset=0;offset<rmt_sizes[i];offset+=0x10000){uint64_t n=rmt_sizes[i]-offset;if(n>0x10000)n=0x10000;if(cfg->part_read(cfg->ctx,rmt_names[i],offset,r->shadow[i]+offset,n))goto fail;}
+  if(cfg->log)cfg->log(cfg->ctx,"eqrf: snapshot index=%u bytes=%u source=%s\n",i,rmt_sizes[i],i<4?"partition read-only":"blank RAM OEM");
+ }
+ return r;
+fail:
+ equuleus_rmtfs_destroy(r);return NULL;
+}
+int equuleus_rmtfs_start(struct equuleus_rmtfs *r,const struct redwood_qrtr_ops *ops,
+ int (*publish)(void *,struct redwood_qrtr_port *,uint32_t,uint32_t,uint32_t),void *ctx){
+ if(!r || r->started || !ops || !ops->open || !ops->send || !ops->close || !publish)return 22;
+ r->ops=ops;r->port=ops->open(rmt_receive,NULL,r);if(!r->port)return 12;r->started=true;
+ int result=publish(ctx,r->port,14,1,1);if(result){equuleus_rmtfs_stop(r);return result;}
+ if(r->cfg.log)r->cfg.log(r->cfg.ctx,"eqrf: published service14/v1/instance1 (RAM shadows only)\n");
+ return 0;
+}
+void equuleus_rmtfs_stop(struct equuleus_rmtfs *r){
+ if(!r)return;
+ if(r->port)r->ops->close(r->port);
+ r->port=NULL;r->started=false;
+ struct rmt_request *q;while((q=r->head)){r->head=q->next;RMT_FREE(q,sizeof(*q)+q->n);}r->tail=NULL;r->queued=0;
+ memset(r->handles,0,sizeof(r->handles));memset(r->cache,0,sizeof(r->cache));r->cache_next=0;
+ if(r->cfg.log)r->cfg.log(r->cfg.ctx,"eqrf: summary requests=%u replies=%u replayed=%u rejected=%u read_batches=%u write_batches=%u (no NV writes)\n",r->requests,r->replies,r->replayed,r->rejected,r->reads,r->writes);
+}
+void equuleus_rmtfs_destroy(struct equuleus_rmtfs *r){
+ if(!r)return;
+ equuleus_rmtfs_stop(r);
+ for(unsigned i=0;i<6;i++)if(r->shadow[i]){rmt_wipe(r->shadow[i],rmt_sizes[i]);RMT_FREE(r->shadow[i],rmt_sizes[i]);}
+ rmt_wipe(r,sizeof(*r));RMT_FREE(r,sizeof(*r));
+}
